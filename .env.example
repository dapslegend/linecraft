# Copy to .env and fill the keys you actually use.
# .env is gitignored. Do not commit a real key.

# Required only when grok.enabled is true. Research is on by default.
GROK_API_KEY=
GROK_MODEL=grok-4.7
GROK_BASE_URL=https://api.x.ai/v1

# Which book to pull. sporty | 1xbet | generic
LINECRAFT_PROVIDER=sporty
LINECRAFT_CONFIG=config.example.json

# Public read + share-code endpoints. No stake field is sent.
SPORTY_ORIGIN=https://www.sportybet.com
SPORTY_UPCOMING_URL=https://www.sportybet.com/api/ng/factsCenter/pcUpcomingEvents
SPORTY_EVENT_URL=https://www.sportybet.com/api/ng/factsCenter/event
SPORTY_SPORTS_URL=https://www.sportybet.com/api/ng/factsCenter/sportList
SPORTY_SHARE_URL=https://www.sportybet.com/api/ng/orders/share

# 1xBet line feed. Leave the share URL empty unless that book has a share-only route.
ONEXBET_LINE_URL=https://1xbet.com/service-api/LineFeed/Get1x2_VZip
ONEXBET_SHARE_URL=

# Any other JSON feed. Map the fields in config under provider "generic".
GENERIC_EVENTS_URL=
GENERIC_SHARE_URL=

# Loopback analysis server only.
LINECRAFT_HOST=127.0.0.1
LINECRAFT_PORT=8787
